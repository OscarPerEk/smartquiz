package track

import (
	"smartquiz/app/views/layouts"
	"smartquiz/app/types"
)

templ Index(germanWords []types.GermanWord) {
	@layouts.App() {
		<div class="flex justify-center mt-10 px-4">
			<div class="w-full max-w-5xl overflow-x-auto rounded-lg shadow border border-gray-200 bg-white bg-opacity-90 dark:bg-gray-900 dark:bg-opacity-90">
				<table class="min-w-full text-left text-sm text-gray-700 dark:text-gray-200">
					<thead class="bg-gray-100 dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700">
						<tr>
							<th class="px-6 py-4 font-semibold tracking-wide">📘 Word</th>
							<th class="px-6 py-4 font-semibold tracking-wide">📖 Definition</th>
							<th class="px-6 py-4 font-semibold tracking-wide">💬 Example</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-gray-100 dark:divide-gray-800">
						for _, germanWord := range germanWords {
							<tr class="hover:bg-gray-50 dark:hover:bg-gray-800 transition">
								<td class="px-6 py-4 font-medium text-blue-700 dark:text-blue-400">{ germanWord.GermanWord }</td>
								<td class="px-6 py-4">{ germanWord.Definition }</td>
								<td class="px-6 py-4 italic text-gray-600 dark:text-gray-400">"{ germanWord.Example }"</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	}
}

